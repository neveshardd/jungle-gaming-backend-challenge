{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor — Jungle Gaming backend challenge",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "migrate": "bun src/infrastructure/database/migrate.ts up",
    "migrate:down": "bun src/infrastructure/database/migrate.ts down",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test --timeout 120000 ./test/integration",
    "test:concurrency": "bun test --timeout 240000 ./test/concurrency",
    "test:load": "bun test/load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/instrumentation-pg": "^0.50.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "ajv": "^8.17.1",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bun": "^1.1.14",
    "@types/express": "^4.17.21",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
