# Role of this process: api (HTTP only) | worker (SQS consumer + outbox + pending-reference worker) | all
APP_ROLE=all
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_TX_MAX_RETRIES=3

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_AUTO_CREATE=true
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_CONSUMER_CONCURRENCY=2
SQS_BATCH_SIZE=10
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_ATTEMPTS=5
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=60

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=300000

PENDING_REF_POLL_INTERVAL_MS=1000
PENDING_REF_BATCH_SIZE=50
PENDING_REF_MAX_ATTEMPTS=10
PENDING_REF_BASE_DELAY_MS=2000
PENDING_REF_MAX_DELAY_MS=300000

SHUTDOWN_GRACE_MS=20000

OTEL_ENABLED=false
OTEL_SERVICE_NAME=wagering-processor
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Test-only fault injection (ignored unless NODE_ENV=test)
FAULT_CRASH_AFTER_COMMIT_BEFORE_ACK=false
